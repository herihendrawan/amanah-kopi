# ─── DATABASE ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/kedai-kopi?retryWrites=true&w=majority

# ─── AUTH ─────────────────────────────────────────────────
JWT_SECRET=ganti_dengan_string_random_panjang_minimal_32_karakter
JWT_EXPIRE=7d

# ─── SERVER ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── CLOUDINARY (untuk upload gambar) ────────────────────
# Daftar gratis di https://cloudinary.com
# Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
